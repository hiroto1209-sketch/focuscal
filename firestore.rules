rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function permissionId(ownerUid, viewerUid) {
      return ownerUid + '_' + viewerUid;
    }

    function canViewCalendar(ownerUid) {
      return signedIn() && (
        request.auth.uid == ownerUid ||
        (
          exists(/databases/$(database)/documents/peekPermissions/$(permissionId(ownerUid, request.auth.uid))) &&
          get(/databases/$(database)/documents/peekPermissions/$(permissionId(ownerUid, request.auth.uid))).data.active == true
        )
      );
    }

    match /users/{uid} {
      allow read, create, update, delete: if isSelf(uid);
    }

    match /shareCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'createdAt']);
      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /events/{eventId} {
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn()
                  && resource.data.ownerUid is string
                  && canViewCalendar(resource.data.ownerUid);
      allow update: if signedIn()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn()
                    && resource.data.ownerUid == request.auth.uid;
    }

    match /peekRequests/{requestId} {
      allow create: if signedIn()
                    && request.resource.data.requesterUid == request.auth.uid
                    && request.resource.data.ownerUid is string
                    && request.resource.data.ownerUid != request.auth.uid
                    && request.resource.data.status == 'pending';

      allow read: if signedIn() && (
        resource.data.requesterUid == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid
      );

      allow update: if signedIn()
                    && request.resource.data.requesterUid == resource.data.requesterUid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && (
                      (
                        request.auth.uid == resource.data.ownerUid
                        && resource.data.status == 'pending'
                        && request.resource.data.status in ['approved', 'rejected']
                      ) ||
                      (
                        request.auth.uid == resource.data.requesterUid
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'cancelled'
                      )
                    );

      allow delete: if signedIn() && (
        resource.data.requesterUid == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid
      );
    }

    match /peekPermissions/{permission} {
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.viewerUid == request.auth.uid
      );

      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.viewerUid is string
                    && request.resource.data.viewerUid != request.auth.uid
                    && request.resource.data.active == true
                    && permission == permissionId(request.resource.data.ownerUid, request.resource.data.viewerUid);

      allow update: if signedIn()
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.viewerUid == resource.data.viewerUid
                    && permission == permissionId(resource.data.ownerUid, resource.data.viewerUid)
                    && (
                      request.auth.uid == resource.data.ownerUid ||
                      (
                        request.auth.uid == resource.data.viewerUid
                        && request.resource.data.active == false
                      )
                    );

      allow delete: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.viewerUid == request.auth.uid
      );
    }

    // In-app product feedback. Any authenticated (including anonymous) FocusCal user
    // may create a bounded feedback document. Clients can never read, edit or delete
    // feedback documents; project admins can review them in Firebase Console.
    match /feedback/{feedbackId} {
      allow create: if signedIn()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.category in ['bug', 'idea', 'ui', 'speed']
                    && request.resource.data.severity in ['normal', 'high', 'critical']
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 3
                    && request.resource.data.message.size() <= 4000
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 100
                    && request.resource.data.steps is string
                    && request.resource.data.steps.size() <= 2000
                    && request.resource.data.keys().hasOnly([
                      'authorUid', 'category', 'title', 'message', 'steps', 'severity',
                      'build', 'viewport', 'platform', 'userAgent', 'path', 'online', 'createdAt'
                    ]);
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
